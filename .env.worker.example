# Local (non-Docker) worker config. Copy to .env.worker1 ... .env.worker4,
# change the four values marked CHANGE in each, then:
#   cargo run -p worker -- .env.worker1
# Variables already set in the shell take priority over this file.

# CHANGE: worker1..worker4. Must stay the same across restarts.
WORKER_ID=worker1
# CHANGE: 8081..8084
PORT=8081
# CHANGE: same port as PORT
ADVERTISE_ADDR=http://localhost:8081
# CHANGE: one folder per worker
DATA_DIR=./data/worker1

CONTROLLER_URL=http://localhost:9000
# Seconds between scrubber passes; 0 disables the scrubber.
SCRUB_INTERVAL_SECS=30
RUST_LOG=info
